{
  "name": "infra-rewind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replay infrastructure changes, deployments, alerts, and rollbacks without claiming deterministic causality.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "analyze": "tsx src/cli.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "demo": "tsx scripts/demo.ts",
    "demo:screenshot": "tsx scripts/capture-demo.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "docs:check": "tsx scripts/check-doc-links.ts",
    "scan:repo": "tsx scripts/scan-repository.ts",
    "verify": "tsx scripts/verify.ts",
    "package": "tsx scripts/package_release.ts",
    "release-check": "tsx scripts/release_check.ts"
  },
  "dependencies": {
    "d3": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/d3": "7.4.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
